# Copy to .env (git-ignored). The server loads .env automatically on start;
# variables already set in your shell take priority.

# Email for OTP codes - set EITHER Brevo (option 1) OR Gmail SMTP (option 2).
#
# Option 1: Brevo HTTP API. Use this on hosts that block mail ports, such as Render's free plan.
# Create a free account at brevo.com, verify MAIL_FROM under Senders, then create an API key
# (SMTP & API > API keys). When BREVO_API_KEY is set, SMTP settings below are ignored.
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=your-verified-sender@gmail.com
#
# Option 2: Gmail SMTP via nodemailer (works locally and on paid hosting).
# SMTP_PASS must be a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords),
# not your normal Gmail password.
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Accounts. Without MONGODB_URI they're saved to .data/users.json (fine locally;
# wiped on every restart on Render's free plan). With it, they're saved in MongoDB.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=udyam_digital

# Keeps users signed in across server restarts. Any long random string, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=replace-with-a-long-random-string

# Optional: turns on the Claude advisor (any language). Leave unset for guided mode.
ANTHROPIC_API_KEY=your-api-key-here

# Optional overrides
# ADVISOR_MODE=rules            # force guided (rule-based) mode
# ADVISOR_MODEL=claude-opus-5-5
# PORT=8787
# DATA_DIR=./data
# UDYAM_TODAY=2026-07-15        # "today" for date checks (dataset README)
